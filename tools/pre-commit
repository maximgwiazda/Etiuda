#!/usr/bin/env sh
# The content scan, at the commit rather than at the push: a name that reaches a commit message
# cannot be taken out of it again without rewriting history, and this repository is public.
#
# HOOKS ARE NOT CLONED, and this one guards two things, so it is installed twice:
#   cp tools/pre-commit .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
#   cp tools/pre-commit .git/hooks/commit-msg && chmod +x .git/hooks/commit-msg
#
# WHAT IT LOOKS FOR IS NOT IN THIS REPOSITORY. A list of names that may not be published is
# itself a thing that may not be published, so it lives at .git/etiuda-names, which no clone
# carries and no commit can reach, and that file documents its own format. Without it the scan
# refuses: a guard that goes quiet when its ammunition is missing is the failure this prevents.
set -u

git_dir="$(git rev-parse --git-dir)"
names="$git_dir/etiuda-names"
tmp="$git_dir/etiuda-scan.$$"
trap 'rm -f "$tmp"' EXIT INT TERM
today="$(date +%F)"
fail=0
say() { echo "etiuda scan: $*" >&2; }

# A hit is reported as a place, never as the text found. Agents read this output and write
# reports from it, so printing the offending line would carry the secret out through the log.
report() { say "$1"; sed 's/^/  /' "$2" >&2; fail=1; }

# PUBLISHED 1.x CONTENT. v1/ is Etiuda 1.16.7, imported whole from etiuda-v1 with its own MIT
# history. That product has been public since it was written, demo catalog and all, so the
# SHAPES it wears are not leaks: its sample catalog declares a catalog payload the way every
# catalog does, and its README documents the format with a worked example. The path rule and
# rule 1, which judge shape, stop at this directory.
#
# RULES 2 AND 3 DO NOT STOP HERE, which is the whole of why the two halves are named apart. A
# listed name, or a line quoting a catalog this repository is holding back, is a leak wherever
# it lands, and a directory that arrives by import rather than by writing is the likeliest
# place for one to travel in unread. The summary line at the end prints how many lines the
# exemption covered, so a run says out loud what it judged by half the rules.
pub_dir="v1/"
published() { case "$1" in "$pub_dir"*) return 0 ;; *) return 1 ;; esac; }

have_names=1
if [ ! -f "$names" ]; then
  if [ "${ETIUDA_SCAN_OFF:-}" = "$today" ]; then
    have_names=0
    say "no list at $names; the name scan stands down for this one command."
  else
    say "the name scan needs its list at $names, and there is none."
    say "install the list, or run this one command with ETIUDA_SCAN_OFF=$today."
    exit 1
  fi
fi

# Three modes, one script: with a message file the message is the text; with --tree every
# tracked line is; otherwise the staged diff is. Added lines carry the file and line number they
# came from, which is the only shape the rules below read.
#
# WHY --tree EXISTS. tools/release.mjs runs this as its name gate, and a release is of a clean
# tree by its own first gate - so a staged diff at that moment is empty and the gate passed on
# nothing, every time. The empty tree as the left-hand side turns the whole of HEAD into added
# lines, so one awk serves all three.
if [ -n "${1:-}" ] && [ -f "${1:-}" ]; then
  what="the commit message"
  awk '!/^#/ { print "(message)\t" FNR "\t" $0 }' "$1" > "$tmp"
else
  if [ "${1:-}" = "--tree" ]; then
    what="the tracked tree"
    diff_of="git diff -U0 --no-color --no-ext-diff $(git hash-object -t tree /dev/null) HEAD"
    paths_of="git ls-files"
  else
    what="the staged diff"
    diff_of="git diff --cached -U0 --no-color --no-ext-diff"
    paths_of="git diff --cached --name-only --diff-filter=ACMR"
  fi
  $diff_of | awk '
    /^\+\+\+ /  { f = substr($0, 7); next }
    /^--- /     { next }
    /^@@ /      { split($0, a, "+"); split(a[2], b, /[, ]/); ln = b[1] + 0; next }
    /^\+/       { print f "\t" ln "\t" substr($0, 2); ln++ }
  ' > "$tmp"

  # A catalog is ignored by name, and `git add -f` walks straight past an ignore rule.
  $paths_of | grep -E '(^|/)[^/]*-catalog\.(js|json)$|(^|/)catalogs/' > "$tmp.named" 2>/dev/null
  : > "$tmp.paths"
  while IFS= read -r p; do
    # The exemption and the ignore file settled against each other. .gitignore's catalog block
    # documents one procedure for publishing a demo - name it back in with a `!` line - so a
    # catalog-named path under the published directory is allowed exactly when git reports it
    # NOT ignored, which is that `!` line and nothing else. Anything else there reached the
    # index past an ignore rule, which is the case this rule exists for, and the directory it
    # landed in does not excuse it. --no-index is load-bearing: without it git answers "not
    # ignored" for every TRACKED path, which is every path this rule ever sees.
    if published "$p" && ! git check-ignore -q --no-index "$p"; then continue; fi
    printf '%s\n' "$p" >> "$tmp.paths"
  done < "$tmp.named"
  rm -f "$tmp.named"
  if [ -s "$tmp.paths" ]; then
    report "a path in $what is named like a catalog:" "$tmp.paths"
  fi
  rm -f "$tmp.paths"
fi

# 1. The format marker. Every catalog file in existence declares itself at the start of a line;
#    the engine only ever mentions the global inside an expression or a string. Published 1.x
#    content is exempt, per the note at the head of this file: the 1.x demo catalog and the 1.x
#    README's worked example both wear this shape on purpose and have done in public for a year.
awk -F'\t' -v PUB="$pub_dir" '{ t = $3; for (i = 4; i <= NF; i++) t = t "\t" $i
  if (index($1, PUB) == 1) next
  if (t ~ /^[ \t]*(window\.)?(PB|E)_(CATALOG|SAMPLE)[ \t]*=[^=]/) print $1 ":" $2 }' "$tmp" > "$tmp.mark"
if [ -s "$tmp.mark" ]; then
  report "a line declares a catalog payload, in $what:" "$tmp.mark"
fi
rm -f "$tmp.mark"

# 2. The names. Words break on non-alphanumerics and on camelCase humps, so a name buried in an
#    identifier still reads as a word. Prefix rather than whole word: a leak is as likely to be
#    inflected or suffixed as it is to stand alone. NO PUBLISHED-CONTENT EXEMPTION HERE, on
#    purpose: see the head of this file. A listed name under v1/ is refused like any other.
if [ "$have_names" = 1 ]; then
  awk -F'\t' -v LIST="$names" '
    function word(w) {
      if (w == "" || (w in safe)) return 0
      if (w in exact) return 1
      return (rx != "" && w ~ rx)
    }
    BEGIN {
      while ((getline l < LIST) > 0) {
        sub(/#.*/, "", l); gsub(/^[ \t]+|[ \t]+$/, "", l)
        if (l == "") continue
        l = tolower(l); c = substr(l, 1, 1)
        if (c == "-") { safe[substr(l, 2)] = 1; continue }
        if (c == "=") { exact[substr(l, 2)] = 1; continue }
        if (index(l, " ")) { phrase[++np] = l; continue }
        pre[++npre] = l
      }
      close(LIST)
      for (i = 1; i <= npre; i++) rx = rx (i > 1 ? "|" : "^(") pre[i]
      if (rx != "") rx = rx ")"
    }
    {
      t = $3; for (i = 4; i <= NF; i++) t = t "\t" $i
      # A hash is base64, and base64 long enough spells anything: five integrity lines in
      # package-lock.json tripped this scan, and a CSP hash in the template would too. The
      # grammar is narrow on purpose - it is where a hash is written and nowhere else.
      gsub(/sha(1|256|384|512)-[A-Za-z0-9+\/=_-]+/, " ", t)
      low = tolower(t); gsub(/[^a-z0-9]+/, " ", low); low = " " low " "
      hit = 0
      for (i = 1; i <= np; i++) if (index(low, " " phrase[i])) { hit = 1; break }
      n = split(t, part, /[^A-Za-z0-9]+/)
      for (i = 1; i <= n && !hit; i++) {
        p = part[i]
        # A word the list calls ours is ours whole. Breaking it at its humps hands the pieces
        # back to the scan, which is how an ordinary compound name turns into a false hit.
        if (tolower(p) in safe) continue
        if (word(tolower(p))) { hit = 1; break }
        if (p !~ /[a-z0-9][A-Z]/) continue
        s = ""
        for (j = 1; j <= length(p); j++) {
          ch = substr(p, j, 1)
          if (ch ~ /[A-Z]/ && j > 1 && substr(p, j - 1, 1) ~ /[a-z0-9]/) {
            if (word(tolower(s))) { hit = 1; break }
            s = ch
          } else s = s ch
        }
        if (!hit && word(tolower(s))) hit = 1
      }
      if (hit) print $1 ":" $2
    }
  ' "$tmp" > "$tmp.names"
  if [ -s "$tmp.names" ]; then
    report "a listed name appears in $what, at:" "$tmp.names"
  fi
  rm -f "$tmp.names"
fi

# 3. The quotes. A comment describes a case, it never quotes the content: the shape carries the
#    reason and carries nothing confidential. Only a catalog this repository is holding back
#    counts, since a tracked one is published already. NO PUBLISHED-CONTENT EXEMPTION HERE
#    either: a held-back catalog quoted under v1/ is quoted, whoever published the file it sits
#    in. That is measured rather than assumed - the import arrived carrying one such line.
cats=""
ncats=0
for f in *-catalog.js *-catalog.json catalogs/*; do
  [ -f "$f" ] || continue
  git check-ignore -q "$f" || continue
  cats="$cats $f"
  ncats=$((ncats + 1))
done
# The same rule the name list is held to: a scan with nothing to look for is not a quiet pass,
# because a silent skip and a clean run read exactly alike. A fresh clone has no catalog beside
# the engine, which is the state this used to go quiet in.
if [ -z "$cats" ]; then
  if [ "${ETIUDA_SCAN_OFF:-}" = "$today" ]; then
    say "no catalog beside the engine; the quote scan stands down for this one command."
  else
    say "the quote scan needs a catalog this repository holds back, and none sits beside the engine."
    say "put one there, or run this one command with ETIUDA_SCAN_OFF=$today."
    fail=1
  fi
fi
if [ -n "$cats" ]; then
  awk -F'\t' -v CATS="$cats" '
    BEGIN {
      nc = split(CATS, cat, " ")
      for (k = 1; k <= nc; k++) {
        if (cat[k] == "") continue
        while ((getline l < cat[k]) > 0) {
          n = split(l, q, "\"")
          for (i = 2; i <= n; i += 2) {
            s = q[i]
            if (length(s) < 14) continue
            s = tolower(s); gsub(/[^a-z0-9]+/, " ", s); gsub(/^ +| +$/, "", s)
            if (split(s, w, " ") < 5) continue
            p = w[1] " " w[2] " " w[3] " " w[4] " " w[5] " " w[6]
            if (length(p) >= 22) probe[p] = 1
          }
        }
        close(cat[k])
      }
    }
    {
      t = $3; for (i = 4; i <= NF; i++) t = t "\t" $i
      t = tolower(t); gsub(/[^a-z0-9]+/, " ", t); gsub(/^ +| +$/, "", t)
      n = split(t, w, " ")
      for (i = 1; i + 5 <= n; i++) {
        p = w[i] " " w[i+1] " " w[i+2] " " w[i+3] " " w[i+4] " " w[i+5]
        if (p in probe) { print $1 ":" $2; break }
      }
    }
  ' "$tmp" > "$tmp.quotes"
  if [ -s "$tmp.quotes" ]; then
    report "content held back by this repository is quoted in $what, at:" "$tmp.quotes"
  fi
  rm -f "$tmp.quotes"
fi

# What ran, in counts, because a scan that reads nothing looks exactly like one that read
# everything and found nothing. This line is how --tree was caught passing on an empty diff, and
# the third count is the same rule applied to the exemption above: a run says how much of what
# it read was judged by half the rules, so a prefix that drifts or a directory that moves shows
# up as a zero rather than as silence.
npub="$(awk -F'\t' -v PUB="$pub_dir" 'index($1, PUB) == 1' "$tmp" | wc -l | tr -d ' ')"
say "$(wc -l < "$tmp" | tr -d ' ') line(s) of $what, against $ncats held-back catalog(s); $npub under $pub_dir judged by name and quote only."
[ "$fail" = 0 ] || say "nothing was committed."
exit "$fail"
