{
 "what": "Etiuda 2.x prefix rename: PB_ to E_, pb to e. Spec 2.0.0 section 9.1.",
 "appliesTo": "engine/etiuda.html at commit 5251902",
 "boundary": "a source is replaced only where the character on each side is outside [A-Za-z0-9_$]; the alternation is tried longest first, so data-pbc wins over pbc",
 "order": "freezeStrings are masked first, then once, then rename",
 "classes": {
  "const": "the PB_ constants, identifiers only",
  "js": "lowercase identifiers and element expandos, identifiers only",
  "doc": "names the document itself carries: CSS classes, keyframes, custom properties, data attributes, element ids"
 },
 "freezeStrings": [
  "\"pbCollapsed\""
 ],
 "keep": {
  "PB_CATALOG": "the global every catalog in existence declares, and the importer literal",
  "PB_SAMPLE": "the global sample-catalog.js declares, a sibling script the engine may or may not find",
  "__pbprobe": "stored key (the storage probe writes and removes it)",
  "pb": "the storage prefix, and the Reset filter that matches it",
  "pbAgent": "stored key",
  "pbBootTry": "stored key (session)",
  "pbCollapsed": "stored key; the identifier of the same name DOES move, so the literal is frozen instead",
  "pbFactsH": "stored key",
  "pbFactsW": "stored key",
  "pbGlassOff": "stored key",
  "pbHdrPills": "stored key",
  "pbLang": "stored key",
  "pbMotionOff": "stored key",
  "pbNoteHover": "stored key",
  "pbPax": "stored key",
  "pbPills": "stored key",
  "pbPillsLock": "stored key",
  "pbRail": "stored key",
  "pbRailLock": "stored key",
  "pbRailW": "stored key",
  "pbReopenLibrary": "stored key",
  "pbSessionTabs": "stored key (session)",
  "pbShortcuts": "stored key",
  "pbTheme": "stored key",
  "pbTour": "stored key prefix",
  "pbTourDone_v": "stored key prefix",
  "pbTourInvite_v": "stored key prefix",
  "pbUiLang": "stored key",
  "pbWho": "stored key"
 },
 "once": [
  {
   "find": "const pb=$(\"#paxClear\"); if(pb) pb.disabled=!String(pax&&pax.value||\"\").length;",
   "to": "const paxClear=$(\"#paxClear\"); if(paxClear) paxClear.disabled=!String(pax&&pax.value||\"\").length;",
   "class": "js",
   "why": "a local named pb; the prefix rule would make it e, which reads as an event"
  },
  {
   "find": "below 560px only the Pb tile remains",
   "to": "below 560px only the Etiuda tile remains",
   "class": "doc",
   "why": "prose, not a name: Pb was the old wordmark"
  }
 ],
