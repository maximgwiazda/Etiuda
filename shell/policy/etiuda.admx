<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions revision="1.0" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="etiuda" namespace="Etiuda.Policies" />
  </policyNamespaces>
  <resources minRequiredRevision="1.0" />
  <supportedOn>
    <definitions>
      <definition name="SUPPORTED_Etiuda" displayName="$(string.SUPPORTED_Etiuda)" />
    </definitions>
  </supportedOn>
  <!-- The Etiuda Studio category is for the other program. This desk reads only the Etiuda values. -->
  <categories>
    <category name="Etiuda" displayName="$(string.EtiudaCat)" />
    <category name="EtiudaStudio" displayName="$(string.EtiudaStudioCat)" />
  </categories>
  <policies>
    <policy name="TeamFolder" class="Machine" displayName="$(string.TeamFolder)" explainText="$(string.TeamFolder_Explain)" key="Software\Policies\Etiuda" presentation="$(presentation.TeamFolder)">
      <parentCategory ref="Etiuda" />
      <supportedOn ref="SUPPORTED_Etiuda" />
      <elements>
        <text id="TeamFolderBox" valueName="TeamFolder" required="true" maxLength="1024" />
      </elements>
    </policy>
    <policy name="LeadKey" class="Machine" displayName="$(string.LeadKey)" explainText="$(string.LeadKey_Explain)" key="Software\Policies\Etiuda" presentation="$(presentation.LeadKey)">
      <parentCategory ref="Etiuda" />
      <supportedOn ref="SUPPORTED_Etiuda" />
      <elements>
        <text id="LeadKeyBox" valueName="LeadKey" required="true" maxLength="64" />
      </elements>
    </policy>
    <policy name="TeamAboveFolder" class="Machine" displayName="$(string.TeamAboveFolder)" explainText="$(string.TeamAboveFolder_Explain)" key="Software\Policies\EtiudaStudio" presentation="$(presentation.TeamAboveFolder)">
      <parentCategory ref="EtiudaStudio" />
      <supportedOn ref="SUPPORTED_Etiuda" />
      <elements>
        <text id="TeamAboveFolderBox" valueName="TeamAboveFolder" required="true" maxLength="1024" />
      </elements>
    </policy>
    <policy name="LeadKeyAbove" class="Machine" displayName="$(string.LeadKeyAbove)" explainText="$(string.LeadKeyAbove_Explain)" key="Software\Policies\EtiudaStudio" presentation="$(presentation.LeadKeyAbove)">
      <parentCategory ref="EtiudaStudio" />
      <supportedOn ref="SUPPORTED_Etiuda" />
      <elements>
        <text id="LeadKeyAboveBox" valueName="LeadKeyAbove" required="true" maxLength="64" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
